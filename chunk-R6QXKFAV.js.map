{
  "name": "ai-design-assistant",
  "version": "0.7.7",
  "_versionFormat": "major.minor.patch",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "build:sandbox": "ng build --configuration sandbox",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "predeploy": "ng build --configuration sandbox --base-href /design-assistant/",
    "deploy": "npx angular-cli-ghpages --dir=dist/design-assistant/browser --no-silent --branch=gh-pages",
    "check": "node scripts/check-missing-translations.js en && node scripts/check-missing-translations.js fr",
    "compare": "node scripts/compare-translations.js en && node scripts/compare-translations.js fr",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./public/i18n/en.json ./public/i18n/fr.json --sort --format json",
    "i18n:clean": "ngx-translate-extract --input ./src --output ./public/i18n/en-clean.json ./public/i18n/fr-clean.json --sort --format json --clean",
    "i18n:check": "npm run i18n:extract && npm run check",
    "i18n:compare": "npm run i18n:clean && npm run compare",
    "i18n:qa": "npm run i18n:extract && npm run i18n:clean && npm run check && npm run compare",
    "checksize": "ng build --configuration production --base-href /design-assistant/ --stats-json && node scripts/check-size.js",
    "install:lambdas": "npm-run-all install:lambda:*",
    "install:lambda:airtable": "cd backend/functions/airtable && npm install",
    "install:lambda:github-oauth": "cd backend/functions/github-oauth && npm install",
    "install:lambda:openrouter": "cd backend/functions/openrouter && npm install",
    "install:lambda:projects": "cd backend/functions/projects && npm install",
    "install:lambda:usage": "cd backend/functions/usage && npm install",
    "postinstall": "npm run install:lambdas",
    "review:check": "node scripts/check-reviewed.js",
    "review:components": "node scripts/check-reviewed.js --dir=components",
    "review:template": "node scripts/check-reviewed.js --dir=template",
    "review:views": "node scripts/check-reviewed.js --dir=views",
    "review:services": "node scripts/check-reviewed.js --dir=services",
    "review:services-comp": "node scripts/check-reviewed.js --dir=component-services",
    "review:stale": "node scripts/check-reviewed.js --older-than=90 --older-than-ng=21 --unreviewed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "organize-imports": "node scripts/organize-imports.mjs && prettier --write .",
    "organize-imports:check": "node scripts/organize-imports.mjs --check",
    "skills:generate": "node scripts/generate-skills-manifest.mjs",
    "skills:check": "node scripts/generate-skills-manifest.mjs --check",
    "skills:test": "node scripts/test-skills-manifest.mjs"
  },
  "private": true,
  "dependencies": {
    "@ali-tas/htmldiff-js": "^2.0.1",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@aws-sdk/client-secrets-manager": "^3.932.0",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeuix/themes": "^3.0.0",
    "chart.js": "^4.5.1",
    "diff": "^8.0.2",
    "diff2html": "^3.4.51",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.1",
    "pdfjs-dist": "^5.3.31",
    "prettier": "^3.6.2",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "text-readability": "^1.1.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/localize": "^21.2.25",
    "@colsen1991/ngx-translate-extract-marker": "^3.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/jasmine": "~5.1.0",
    "@types/prismjs": "^1.26.5",
    "@vendure/ngx-translate-extract": "^10.2.0",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "20.2.0",
    "baseline-browser-mapping": "^2.9.7",
    "eslint": "^9.33.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-run-all": "^4.1.5",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "8.40.0"
  }
}
